# Exemplos por ambiente:
# - .env.dev.example
# - .env.staging.example
# - .env.prod.example

# Para desenvolvimento no host (npm run dev) use um DATABASE_URL com localhost.
DATABASE_URL=postgres://financeiro_user:financeiro_pass@localhost:5432/financeiro_dev

# Usado pelo docker-compose (container do Postgres)
POSTGRES_USER=financeiro_user
POSTGRES_PASSWORD=financeiro_pass
POSTGRES_DB=financeiro_dev

# Chave usada para assinar cookies de sessão (troque em produção)
SESSION_SECRET=troque-esta-chave-grande-e-aleatoria

# Se true, o cookie de sessão só funciona em HTTPS.
# Em dev (HTTP), use false.
COOKIE_SECURE=false

# (Cartão de crédito) Chave para criptografia de dados sensíveis (AES-256-GCM).
# Gere 32 bytes e encode em base64, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CARD_ENCRYPTION_KEY=

# Portas (dev)
APP_PORT=3000
DB_PORT=5432
