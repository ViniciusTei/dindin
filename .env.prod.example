# Produção (VPS)
POSTGRES_USER=financeiro_prod
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=financeiro_prod

SESSION_SECRET=troque-esta-chave-grande-e-aleatoria

# Como vai atrás de Nginx com HTTPS, mantenha true
COOKIE_SECURE=true

# (Cartão de crédito) Chave para criptografia de dados sensíveis (AES-256-GCM, base64 de 32 bytes)
CARD_ENCRYPTION_KEY=

APP_PORT=3000
