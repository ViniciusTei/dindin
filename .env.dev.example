# Dev local (Windows/Linux)
# - Para rodar o app no host (npm run dev), use localhost no DATABASE_URL.
# - Para rodar o Postgres via Docker, use os POSTGRES_* abaixo.

# Usado pelo app (host) e pelo drizzle-kit (host)
DATABASE_URL=postgres://financeiro_user:financeiro_pass@localhost:5432/financeiro_dev

# Usado pelo docker-compose (container do Postgres)
POSTGRES_USER=financeiro_user
POSTGRES_PASSWORD=financeiro_pass
POSTGRES_DB=financeiro_dev

# Sessão
SESSION_SECRET=troque-esta-chave-grande-e-aleatoria

# Em dev deve ser false (HTTP)
COOKIE_SECURE=false

# (Cartão de crédito) Chave para criptografia de dados sensíveis (AES-256-GCM, base64 de 32 bytes)
CARD_ENCRYPTION_KEY=

# Portas
APP_PORT=3000
DB_PORT=5432
